APP_NAME=Lead Qualification Agent
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_agent
REDIS_URL=redis://localhost:6379/0

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_RPM_LIMIT=10

LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=lead-qualification-agent

VERTICAL=generic                # generic | real_estate | insurance
BUSINESS_NAME=Your Business Name  # Used in all lead-facing prompts
QUALIFICATION_THRESHOLD_HOT=0.7
QUALIFICATION_THRESHOLD_WARM=0.4
HUMAN_HANDOFF_CONFIDENCE=0.3

# Demo token signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
DEMO_TOKEN_SECRET=change-me-to-a-random-64-char-string

# ── Multi-Tenancy / Auth (Phase 1) ───────────────────────────────────────
# Enable multi-tenant auth (set to True when migration is complete)
AUTH_ENABLED=false
# JWT signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Default tenant name for single-tenant (legacy) mode
DEFAULT_TENANT_NAME=Default Organization

# ── CRM Integrations (Phase 2) ───────────────────────────────────────────
API_KEY=                           # Master API key for webhook auth
CALENDLY_API_KEY=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_USER_URI=
CALENDLY_ENABLED=false
CALENDAR_AVAILABILITY_DAYS=14
MEETING_DURATION_MINUTES=30

# ── Twilio SMS ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ENABLED=false
